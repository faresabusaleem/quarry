     "q4": {
      "id": "q4",
      "kind": "sql",
      "sql": "SELECT \n    sum(case when extract(year FROM o.order_purchase_timestamp) = 2017 then i.price end) as r2017,\n    sum(case when extract(year FROM o.order_purchase_timestamp) = 2018 then i.price end) as r2018,\n    (r2018 - r2017) / r2017 * 100 as growth_pct\nFROM orders o\nJOIN order_items i ON o.order_id = i.order_id\nWHERE o.order_status NOT IN ('canceled', 'unavailable')\n  AND extract(month FROM o.order_purchase_timestamp) <= 8\n  AND extract(year FROM o.order_purchase_timestamp) IN (2017, 2018)",

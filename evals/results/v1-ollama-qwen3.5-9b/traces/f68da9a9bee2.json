   "data": {
    "call_id": "call_2y3dgads",
    "tool": "run_sql",
    "args": {
     "purpose": "Count number of orders by month in 2017",
     "sql": "SELECT \n    strftime(order_purchase_timestamp, '%Y-%m') as order_month,\n    COUNT(DISTINCT order_id) as num_orders\nFROM orders\nWHERE extract(year FROM order_purchase_timestamp) = 2017\nGROUP BY strftime(order_purchase_timestamp, '%Y-%m')\nORDER BY order_month"
    }
   }
  },

    "tool": "run_sql",
    "args": {
     "purpose": "Count orders placed in each month of 2017 with the standard status filter",
     "sql": "SELECT\n  strftime(order_purchase_timestamp, '%Y-%m') AS month,\n  COUNT(DISTINCT order_id) AS order_count\nFROM orders\nWHERE extract(year FROM order_purchase_timestamp) = 2017\n  AND order_status NOT IN ('canceled', 'unavailable')\nGROUP BY 1\nORDER BY 1"
    }
   }
  },

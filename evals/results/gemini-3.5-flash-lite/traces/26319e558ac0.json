     "q2": {
      "id": "q2",
      "kind": "sql",
      "sql": "WITH seller_rev AS (\n    SELECT \n        s.seller_id,\n        SUM(oi.price) AS revenue\n    FROM sellers s\n    JOIN order_items oi ON s.seller_id = oi.seller_id\n    JOIN orders o ON oi.order_id = o.order_id\n    WHERE o.order_status NOT IN ('canceled', 'unavailable')\n    GROUP BY s.seller_id\n),\ntotal AS (\n    SELECT SUM(revenue) AS total_rev FROM seller_rev\n)\nSELECT \n    sr.seller_id,\n    sr.revenue,\n    (sr.revenue * 100.0 / t.total_rev) AS pct_share\nFROM seller_rev sr\nCROSS JOIN total t\nORDER BY sr.revenue DESC\nLIMIT 1",
      "purpose": "Get top seller share of total marketplace revenue",

    "args": {
     "purpose": "Count orders placed in each month of Jan-Aug 2018 and total orders for the period",
     "sql": "WITH monthly AS (\n  SELECT\n    strftime(order_purchase_timestamp, '%Y-%m') AS month,\n    COUNT(DISTINCT order_id) AS order_count\n  FROM orders\n  WHERE order_purchase_timestamp >= '2018-01-01'\n    AND order_purchase_timestamp < '2018-09-01'\n    AND order_status NOT IN ('canceled', 'unavailable')\n  GROUP BY 1\n  ORDER BY 1\n)\nSELECT \n  month,\n  order_count,\n  (SELECT SUM(order_count) FROM monthly) AS total_orders\nFROM monthly"
    }
   }

     "purpose": "Count orders per month in 2017 excluding canceled and unavailable orders",
     "sql": "SELECT \n    strftime(order_purchase_timestamp, '%Y-%m') AS month,\n    COUNT(DISTINCT order_id) AS order_count\nFROM orders\nWHERE extract(year FROM order_purchase_timestamp) = 2017\n  AND order_status NOT IN ('canceled', 'unavailable')\nGROUP BY month\nORDER BY month;"
    }
   }

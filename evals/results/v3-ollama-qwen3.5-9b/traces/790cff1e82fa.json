     "sql": "SELECT \n    strftime(order_purchase_timestamp, '%Y-%m') as month,\n    COUNT(DISTINCT order_id) as order_count\nFROM orders\nWHERE order_purchase_timestamp >= '2017-01-01' AND order_purchase_timestamp < '2018-01-01'\nGROUP BY strftime(order_purchase_timestamp, '%Y-%m')\nORDER BY month",
     "purpose": "Count orders by month for 2017"
    }
   }

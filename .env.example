# Copy to .env and fill in. Never commit .env.

# LLM provider: "gemini" (Gemini API free tier) or "ollama" (local model)
QUARRY_PROVIDER=ollama
# Optional model override. Defaults: gemini -> gemini-3.5-flash-lite, ollama -> qwen3.5:9b
# QUARRY_MODEL=

# Create a free key at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=
# Client-side pacing for the Gemini free tier (requests per minute). Check your project's
# real limits in AI Studio; Google no longer publishes fixed free-tier numbers.
QUARRY_GEMINI_RPM=10

QUARRY_OLLAMA_HOST=http://localhost:11434
